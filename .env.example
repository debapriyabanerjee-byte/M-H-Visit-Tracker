# ---------------------------------------------------------------------------
# M&H Visit Tracker — environment configuration
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Deployed Google Apps Script Web App URL (ends in /exec).
# Get this after deploying Google_Apps_Script.gs as a Web App.
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXX/exec

# App version surfaced on the Profile / Settings screens.
NEXT_PUBLIC_APP_VERSION=1.0.0

# Deployment environment label (development | staging | production).
NEXT_PUBLIC_ENVIRONMENT=production
